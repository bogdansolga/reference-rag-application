# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/rag_training

# ── Claude generation backend (provider-agnostic) ────────────────────────────
# direct = Claude via the Anthropic API (needs ANTHROPIC_API_KEY) — works without Vertex quota.
# vertex = Claude on Vertex AI (EU region, ADC, no key) — flip here once the GCP project has quota.
CHAT_BACKEND=direct
CHAT_MODEL=claude-sonnet-4-6

# Direct backend (CHAT_BACKEND=direct):
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Vertex backend (CHAT_BACKEND=vertex) AND embeddings (always Vertex). Auth = gcloud ADC, no key.
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
CLOUD_ML_REGION=europe-west1

# ── Embeddings (always Vertex AI) ────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSIONS=768          # must match the model + the pgvector column

# ── Retrieval + ingestion ────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_CHUNK_SIZE=2000               # characters (~500 tokens)
RAG_CHUNK_OVERLAP=200             # characters (~50 tokens)
RAG_EMBEDDING_BATCH_SIZE=20
